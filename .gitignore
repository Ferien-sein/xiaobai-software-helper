# 忽略构建产物
build/
dist/
*.spec

# 忽略运行数据（各自机器上生成）
config.json
src/config.json
需求存档/
显示诊断.txt

# 忽略 Python 缓存
__pycache__/
*.pyc
*.pyo

# 虚拟环境
.venv/
venv/
env/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# 本机排查时生成的截图（正式截图在 assets/）
截图_*.png

# 构建 / 自检过程产生的临时文件（不该进仓库）
_pyi.log
build.log
build.err.log
.verify-config.json
.exe-test-config.json
.screenshot-config.json
exe-*.png
verify-text-visible.png
verify-adaptive-*.png

# 安装器：payload 是从 dist/ 复制来的程序（31MB），不进仓库
installer/payload/
installer/build/
installer/dist/
installer/_test_payload/
installer/_test_install/
